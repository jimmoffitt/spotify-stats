# Spotify API credentials — copy to .local.env and fill in.
# Create an app at https://developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Optional overrides
SPOTIFY_TOKEN_FILE=data/spotify_tokens.json

# setlist.fm API key — powers the Concert matches section on the Binges and
# Concerts page. Free, non-commercial key: apply at
# https://www.setlist.fm/settings/api (requires a free setlist.fm account).
SETLISTFM_API_KEY=your_setlistfm_api_key
